# Standard: Modellaufrufe über eure OpenRouter-Credits.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Noch günstiger zum Testen: google/gemini-2.5-flash-lite

# Websuche benötigt einen separaten Firecrawl-Zugang.
FIRECRAWL_API_KEY=
HOST=127.0.0.1
PORT=3000

# Optionaler Direktzugang: MODEL_PROVIDER=openai setzen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
